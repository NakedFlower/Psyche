FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ARG INSTALL_WAV2LIP_DEPS=false
ARG INSTALL_MUSETALK_DEPS=false

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    git \
    libglib2.0-0 \
    libgl1 \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

COPY apps/avatar-worker ./apps/avatar-worker
COPY packages ./packages
COPY scripts/benchmark-lipsync.sh ./scripts/benchmark-lipsync.sh
COPY models/README.md ./models/README.md

RUN chmod +x ./scripts/benchmark-lipsync.sh
RUN if [ "$INSTALL_WAV2LIP_DEPS" = "true" ]; then \
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir \
      torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 \
      --index-url https://download.pytorch.org/whl/cu121 \
    && python3 -m pip install --no-cache-dir -r apps/avatar-worker/requirements-wav2lip.txt; \
  fi
RUN if [ "$INSTALL_MUSETALK_DEPS" = "true" ]; then \
    python3 -m pip install --no-cache-dir "pip<25" "setuptools==59.5.0" wheel \
    && python3 -m pip install --no-cache-dir \
      torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 \
      --index-url https://download.pytorch.org/whl/cu118 \
    && python3 -m pip install --no-cache-dir -r apps/avatar-worker/requirements-musetalk.txt \
    && python3 -m pip install --no-cache-dir "numpy==1.23.5" "Cython<3" \
    && python3 -m pip install --no-cache-dir --no-build-isolation --no-use-pep517 "chumpy==0.70" \
    && python3 -m pip install --no-cache-dir -U openmim \
    && mim install mmengine \
    && mim install "mmcv==2.0.1" \
    && mim install "mmdet==3.1.0" \
    && mim install "mmpose==1.1.0" \
    && python3 -m pip install --no-cache-dir "numpy==1.23.5" "Cython<3" \
    && python3 -m pip uninstall -y xtcocotools \
    && python3 -m pip install --no-cache-dir --no-build-isolation --no-binary xtcocotools "xtcocotools==1.14.3"; \
  fi

CMD ["./scripts/benchmark-lipsync.sh", "--engine", "dry-run", "--generate-fixtures", "--out-dir", "runs/lipsync/docker-smoke"]

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg git \
  && rm -rf /var/lib/apt/lists/*

COPY apps/avatar-worker ./apps/avatar-worker
COPY packages ./packages
COPY models ./models

CMD ["sh", "-c", "echo 'Avatar worker scaffold ready. Add runtime entrypoint after implementation.' && sleep infinity"]

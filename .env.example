# ------------------------------------------------------------
# Psyche Avatar Lab
# 이 파일을 `.env`로 복사해서 사용하세요.
# 실제 키/시크릿은 절대 커밋하지 마세요.
# ------------------------------------------------------------

# =========================
# LiveKit
# =========================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 로컬 웹/API 서버 주소
AVATAR_LAB_HOST=127.0.0.1
AVATAR_LAB_PORT=5174
AVATAR_LAB_DEFAULT_ROOM=psyche-avatar-lab
AVATAR_LAB_TOKEN_TTL_SECONDS=3600

# room-agent가 prepared session을 읽어올 로컬 서버 주소
AVATAR_LAB_SERVER_URL=http://127.0.0.1:5174

# =========================
# Agent 기본 설정
# =========================
AVATAR_AGENT_MODE=realtime
AVATAR_AGENT_TTS_PROVIDER=elevenlabs
AVATAR_AGENT_IDENTITY=psyche-node-agent
AVATAR_AGENT_NAME=Psyche Node Agent

# 선택값: 고정 persona 파일을 직접 지정할 때만 사용
AVATAR_PERSONA_FILE=

# 턴/감지 관련
AVATAR_AGENT_LISTEN_SECONDS=4
AVATAR_AGENT_MAX_TURNS=50
AVATAR_AGENT_MAX_WAIT_SECONDS=20
AVATAR_AGENT_VAD_THRESHOLD=400
AVATAR_AGENT_VAD_MIN_SPEECH_MS=300
AVATAR_AGENT_VAD_SILENCE_MS=900
AVATAR_AGENT_INTERRUPT_ENABLED=true
AVATAR_AGENT_INTERRUPT_MIN_SPEECH_MS=100
AVATAR_AGENT_OUTPUT_QUEUE_MS=120
AVATAR_AGENT_GREETING_ENABLED=false

# 오디오/비디오 출력 기본값
AVATAR_AGENT_SAMPLE_RATE=48000
AVATAR_AGENT_FPS=10
AVATAR_AGENT_VIDEO_WIDTH=640
AVATAR_AGENT_VIDEO_HEIGHT=360
AVATAR_AGENT_PUBLISH_PLACEHOLDER_VIDEO=false
AVATAR_AGENT_MOCK_AVATAR_ENABLED=true
AVATAR_AGENT_MOCK_AVATAR_GAIN=18
AVATAR_AGENT_MOCK_AVATAR_DECAY=0.72

# 생성된 답변 영상을 함께 붙일 때
AVATAR_AGENT_VIDEO_REPLY_ENABLED=false
AVATAR_AGENT_VIDEO_REPLY_SUPPRESS_REALTIME_AUDIO=true
AVATAR_AGENT_VIDEO_REPLY_PLAY_ELEVENLABS=true
AVATAR_AGENT_VIDEO_REPLY_MAX_AUDIO_SECONDS=4

# GPU avatar-worker 주소
AVATAR_WORKER_URL=http://127.0.0.1:8080
AVATAR_LIPSYNC_ENGINE=wav2lip
AVATAR_FACE_PATH=models/assets/face-still.jpg

# =========================
# Azure OpenAI Realtime
# =========================
OPENAI_REALTIME_PROVIDER=azure
OPENAI_REALTIME_MODEL=gpt-realtime
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-realtime
AZURE_OPENAI_API_VERSION=preview

# OpenAI fallback / legacy
OPENAI_API_KEY=

# 음성 선택
AVATAR_VOICE_MODE=auto
AVATAR_USER_VOICE_GENDER=neutral
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_FEMALE=marin
OPENAI_REALTIME_VOICE_MALE=cedar
OPENAI_REALTIME_VOICE_NEUTRAL=marin
OPENAI_CUSTOM_VOICE_ID=
OPENAI_REALTIME_INSTRUCTIONS=
OPENAI_REALTIME_GREETING=

# 비용 추정용 기본 단가 메모
OPENAI_REALTIME_TEXT_INPUT_PER_1M=4
OPENAI_REALTIME_TEXT_OUTPUT_PER_1M=16
OPENAI_REALTIME_AUDIO_INPUT_PER_1M=32
OPENAI_REALTIME_AUDIO_OUTPUT_PER_1M=64
OPENAI_REALTIME_CACHED_INPUT_PER_1M=0.4

# =========================
# Azure Persona Generation
# =========================
PERSONA_PROVIDER=azure
AZURE_OPENAI_PERSONA_ENDPOINT=
AZURE_OPENAI_PERSONA_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_PERSONA_API=responses
AZURE_OPENAI_PERSONA_MAX_TOKENS=1800
AZURE_OPENAI_PERSONA_TEMPERATURE=0.75

# =========================
# Azure Image Generation
# =========================
IMAGE_PROVIDER=azure
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_VERSION=preview
AZURE_OPENAI_IMAGE_SIZE=1024x1024

# OpenAI image fallback / legacy
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# =========================
# ElevenLabs
# =========================
ELEVENLABS_API_KEY=

# 선택값:
# - 비워두면 Prepare 단계에서 room별 voice를 준비해서 agent가 동적으로 읽음
# - 넣어두면 고정 테스트 voice를 재사용
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_REUSE_EXISTING=true

ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LIVEKIT_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY_BOOST=0.8

# =========================
# 로컬 ffmpeg / ffprobe
# =========================
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# =========================
# Bedrock (선택 / 과거 실험용)
# =========================
AWS_REGION=us-east-1
BEDROCK_AUTH_MODE=bearer
BEDROCK_API_KEY_NAME=
BEDROCK_BEARER_TOKEN=
BEDROCK_API_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MAX_TOKENS=1800
BEDROCK_TEMPERATURE=0.45

# =========================
# Tavus MVP 관련 값
# avatar-lab 실험에는 직접 쓰지 않지만 기존 저장소 호환용으로 남겨둠
# =========================
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
TAVUS_LANGUAGE=korean
TAVUS_VOICE_NAME=anna
